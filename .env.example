# PostgreSQL local
DB_HOST=db-os
DB_NAME=oficina_os_db
DB_USER=postgres
DB_PASSWORD=12345os

# MongoDB local. Para Atlas, substitua pela URI mongodb+srv completa.
MONGO_URI=mongodb://admin:12345mongo@mongodb-os:27017/os_history?authSource=admin
MONGO_DATABASE=os_history

# RabbitMQ local. Para CloudAMQP, use os valores fornecidos pelo serviço,
# porta 5671 e RABBIT_SSL_ENABLED=true.
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_VHOST=/
RABBIT_SSL_ENABLED=false

# Outros microsserviços
BILLING_SERVICE_URL=http://billing-service:8081
EXECUTION_SERVICE_URL=http://execution-service:8082
